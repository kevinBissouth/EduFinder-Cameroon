SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/edufinder
# Hébergement sans MySQL : un fichier SQLite, chemin relatif à backend_django/
# DATABASE_URL=sqlite:///edufinder.sqlite3
CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost", "127.0.0.1"]
DEBUG=false
ACCESS_TOKEN_EXPIRE_MINUTES=120
COOKIE_SECURE=false
# Nombre de serveurs intermédiaires devant Django (0 en local, 1 derrière un hébergeur)
TRUSTED_PROXY_COUNT=0
